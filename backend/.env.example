# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=versus
MYSQL_PASSWORD=versus_dev
MYSQL_DATABASE=versus_erp
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_IDLE_TIME=300

# MongoDB
MONGO_URI=mongodb://versus:versus_dev@localhost:27017/versus_erp?authSource=admin

# Redis
REDIS_URI=redis://:versus_dev@localhost:6379

# RabbitMQ
RABBITMQ_URI=amqp://versus:versus_dev@localhost:5672

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=24h

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# OpenAI
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
